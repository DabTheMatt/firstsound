{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://field.local/activity/snapshot.schema.json",
  "title": "FIELD activity public snapshot",
  "description": "Allowlisted project statistics. Schema 1. Daily dates are Europe/Warsaw calendar dates of Drive createdTime. This schema describes the shape. FIELD and the Apps Script also check that the totals match.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "timezone",
    "activityBasis",
    "synchronization",
    "project",
    "students",
    "dailyActivity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timezone": { "const": "Europe/Warsaw" },
    "activityBasis": { "const": "createdTime" },
    "synchronization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "lastSynchronizationAt"],
      "properties": {
        "status": { "const": "complete" },
        "lastSynchronizationAt": { "type": "string", "format": "date-time" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalStudents",
        "activeStudents",
        "totalRecordings",
        "totalBytes",
        "recordingsLast7Days",
        "recordingsLast30Days",
        "lastSynchronizationAt"
      ],
      "properties": {
        "totalStudents": { "type": "integer", "minimum": 0 },
        "activeStudents": { "type": "integer", "minimum": 0 },
        "totalRecordings": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "recordingsLast7Days": { "type": "integer", "minimum": 0 },
        "recordingsLast30Days": { "type": "integer", "minimum": 0 },
        "lastSynchronizationAt": { "type": "string", "format": "date-time" }
      }
    },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["studentId", "displayName", "recordingCount", "totalBytes", "lastActivityAt"],
        "properties": {
          "studentId": { "type": "string", "pattern": "^stu_[a-f0-9]{16}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "recordingCount": { "type": "integer", "minimum": 0 },
          "totalBytes": { "type": "integer", "minimum": 0 },
          "lastActivityAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "dailyActivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "count"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
